<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks that KC's built DLLs bind on a given 7D2D install. Not part of
    KitsuneCommand.sln: it needs a real game install, which CI doesn't have.
    See docs/REFERENCE-ASSEMBLIES.md#checking-a-new-game-version.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
